{
  "crons": [
    {
      "path": "/api/heartbeat",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://jo-s-website-production.up.railway.app/api/$1"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "dest": "/"
    },
    {
      "src": "^/(prices|contact|privacy|order|checkout|success|admin)/+$",
      "status": 308,
      "dest": "/$1"
    },
    {
      "src": "^/(admin|checkout|success)$",
      "headers": {
        "x-robots-tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(prices|contact|privacy|order|checkout|success|admin)$",
      "dest": "/index.html"
    }
  ]
}
